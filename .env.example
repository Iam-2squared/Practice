# No real money, exchange account, broker, leverage or order routing.
# Local dev uses .local-crypto-fx/, separate from the legacy local wallet.
PRACTICE_STORE=file
PORT=3000
# Vercel: PRACTICE_STORE=supabase and the four server-only settings below.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Keep the EXISTING APP_SECRET for existing accounts. Never paste it into source.
APP_SECRET=
APP_ORIGIN=
# Free CoinGecko Demo key, server-only. Missing key disables crypto quotes, not FX.
COINGECKO_DEMO_API_KEY=
# Old MARKET_PROVIDER and YAHOO_DATA_USE_APPROVED variables are no longer used.
