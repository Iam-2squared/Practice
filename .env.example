# No real money or brokerage integration exists in this app.
# Local-only accounts persist in .local/; NEVER select file mode on Vercel.
PRACTICE_STORE=file
MARKET_PROVIDER=demo
PORT=3000
# Production: set PRACTICE_STORE=supabase, then configure all four below.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Exact public HTTPS origin, e.g. https://your-practice.vercel.app (no trailing slash)
APP_ORIGIN=
# Do not enable Yahoo in a public app without permission covering access and redistribution.
YAHOO_DATA_USE_APPROVED=false
